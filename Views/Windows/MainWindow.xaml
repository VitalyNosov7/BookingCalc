<Window x:Class="BookingCalc.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingCalc"
		xmlns:sys="clr-namespace:System;assembly=mscorlib"
		xmlns:ts="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
		xmlns:vm="clr-namespace:BookingCalc.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <DockPanel LastChildFill="True" Margin="5">
        
        <!-- MENU панель главного окна-->
        <Menu Name="GridTop1" DockPanel.Dock="Top" Background="Tan" Width="Auto" Height="30">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" />
            </MenuItem>
            <MenuItem Header="Правка"/>
            <MenuItem Header="База данных" >
                <MenuItem Header="Прайс" Command="{Binding OpenWindowsCommands.OpenPriceBookingWindomCommand}"></MenuItem>               
            </MenuItem>
        </Menu>


        <!-- Bottom панель главного окна-->
        <Grid Name="GridBottom" DockPanel.Dock="Bottom" Background="BlanchedAlmond" Width="Auto" Height="30">
        </Grid>

               <!-- LEFT панель главного окна-->
       <Grid Name="GridLeft" DockPanel.Dock="Left" Background="Aquamarine" Width="200" Height="Auto">
			
			<StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
				<!--НАЗВАНИЕ САНАТОРИЯ-->
				<TextBlock Margin="3,0,0,0" 
						   Width="100" 
						   Height="20" 
						   HorizontalAlignment="Left" 
						   VerticalAlignment="Bottom" 
						   Text="Санаторий"/>
				<StackPanel Orientation="Horizontal">
					<ComboBox x:Name="Sanatorium"
								Width="100"
								Margin="3,0,3,1"
								ItemsSource="{Binding SanatoriumList}"
								SelectedItem="{Binding SelectedSanatorium, UpdateSourceTrigger=PropertyChanged}"							
								IsTextSearchEnabled="True"                                            
								TextSearch.TextPath="SanatoriumName">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock>
									<TextBlock.Text>
										<MultiBinding StringFormat="{}{0}">
											<Binding Path="SanatoriumName"/>
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<Button Content="DB"
												Command="{Binding OpenWindowsCommands.OpenSanatoriumWindomCommand}"
												Width="30"
												Height="20"
												Margin="3,3,3,3"/>

					<Button Content="R"
												Command="{Binding LoadingSanatoriumListFromDatabaseCommand}"
												Width="30"
												Height="20"
												Margin="3,3,3,3"/>
				</StackPanel>
				<Button Content="Получить расчет" Command="{Binding GetBookingQuoteCommand}" Margin="5,5,10,0"/>
				<Button Content="Сохранить в Excel" Command="{Binding SaveToExcelCommand}" Margin="5,5,10,0"/>
			</StackPanel>
		</Grid>

        <!-- Centr панель главного окна-->
        <Grid x:Name="TabArea" Background="LightGreen" Width="Auto" Height="Auto">
            
                <StackPanel Width="Auto"
			Orientation="Vertical">

				<DataGrid ItemsSource="{Binding CalcBookings}" 
					  SelectedItem="{Binding SelectedBookingOperation, Mode=TwoWay}"
					  AutoGenerateColumns="True"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
					  GridLinesVisibility="All"
					  CanUserAddRows="False"
					  IsReadOnly="True"
					  Height="400">
                        <DataGrid.Columns>
						    <DataGridTextColumn Header="№" Binding="{Binding CalcBookingDataID}" Width="50"/>
						    <DataGridTextColumn Header="Санаторий" Binding="{Binding SanatoriumID}" Width="150"/>
						    <DataGridTextColumn Header="Категория номера" Binding="{Binding RoomCategoryID}" Width="150"/>
                            <DataGridTextColumn Header="Продолжительность" Binding="{Binding TextTemplateID}" Width="50"/>
                            <DataGridTextColumn Header="Дата заезда" Binding="{Binding StartDate}" Width="200"/>
						    <DataGridTextColumn Header="Дата выезда" Binding="{Binding EndDate}" Width="200"/>
						    <DataGridTextColumn Header="Тип размещения" Binding="{Binding AccommodationTypeID}" Width="150"/>
						    <DataGridTextColumn Header="Стоимость путевки" Binding="{Binding PriceFromGuest}" Width="150"/>
                            <DataGridTextColumn Header="Стоимость путевки + ПНК + ЗД" Binding="{Binding PrefixFileName}" Width="150"/>
                            <DataGridTextColumn Header="К-во номеров" Binding="{Binding TextTemplateID}" Width="50"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            
        </Grid>
    </DockPanel>
</Window>
